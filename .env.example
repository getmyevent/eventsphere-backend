# =============================================================================
# EventSphere Backend - Environment Variables Configuration
# =============================================================================

# Server Port
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (MySQL 8.0+)
DATABASE_URL=jdbc:mysql://localhost:3306/eventsphere_dev?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=utf-8&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DATABASE_USERNAME=root
DATABASE_PASSWORD=password

# Security & Session Token
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=259200000

# -----------------------------------------------------------------------------
# Google OAuth Configuration (Google Identity Services)
# -----------------------------------------------------------------------------
# Client ID obtained from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=1031947527724-gqcj9phog0kfubj1l1e0vg83uish36g2.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Email OTP Authentication Provider
# Allowed values: mock | resend | smtp
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=mock
EMAIL_FROM=EventSphere <login@eventsphere.com>

# Resend API Configuration (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# SMTP Configuration (when EMAIL_PROVIDER=smtp)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password
SMTP_AUTH=true
SMTP_STARTTLS=true
